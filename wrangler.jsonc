{
  "name": "decision-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "KV_MEMORY",
      "id": "mock-id-for-dev",
      "preview_id": "mock-preview-id-for-dev"
    }
  ],
  "workflows": [
    {
      "name": "research-workflow",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflow"
    }
  ]
}
