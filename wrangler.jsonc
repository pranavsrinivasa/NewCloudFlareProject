{
  "name": "decision-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MEMORY",
        "class_name": "AgentMemory"
      }
    ]
  },
  "workflows": [
    {
      "name": "research-workflow",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentMemory"]
    }
  ]
}
